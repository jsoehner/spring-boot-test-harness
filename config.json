{
  "kernel_image_path": "/usr/local/bin/kernel.img",
  "boot-source": {
    "kernel_image_path": "/usr/local/bin/kernel.img"
  },
  "boot_timeout_ms": 10000,
  "machine_config": {
    "vm_name": "harness-target-app",
    "cpu_model": "host",
    "cpu_count": 2,
    "mem_size": 1024,
    "port_mappings": [
      {
        "guest_port": 8080,
        "host_port": 8080,
        "host_protocol": "tcp"
      }
    ]
  },
  "drives": [
    {
      "drive_id": "root",
      "path_on_host": "/usr/local/bin/rootfs.img",
      "is_root_device": true
    }
  ]
}
